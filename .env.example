# CausalRecover Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./causal_recover.db

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM (Optional - system works without it)
LLM_PROVIDER=none
LLM_API_KEY=

# Webhook security (set true whenever Razorpay signs your events)
WEBHOOK_SIGNATURE_REQUIRED=false
